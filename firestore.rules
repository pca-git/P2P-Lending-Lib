rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /kv/{key} {
      allow read: if true;
      allow write: if key in ['books', 'lenders', 'admin', 'genres', 'languages']
        && request.resource.data.keys().hasOnly(['value'])
        && request.resource.data.value is string
        && request.resource.data.value.size() < 900000;
    }
  }
}
